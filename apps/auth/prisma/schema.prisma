generator client {
    provider = "prisma-client-js"
    output   = "../src/prisma-client"
}

datasource db {
    provider = "mysql"
    url      = env("AUTH_DATABASE_URL")
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
    name     String

    @@map("user")
}
